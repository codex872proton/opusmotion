[
 {
  "id": "b01",
  "scene": "hook",
  "text": "November, 1952. The CIA gets a radio message from deep inside China.",
  "gap": 0.3,
  "file": "/tmp/hoplite/workspace/film/build/vo/b01.wav",
  "sr": 24000,
  "dur": 5.717333333333333
 },
 {
  "id": "b02",
  "scene": "hook",
  "text": "The pickup worked.",
  "gap": 0.5,
  "file": "/tmp/hoplite/workspace/film/build/vo/b02.wav",
  "sr": 24000,
  "dur": 1.0666666666666667
 },
 {
  "id": "b03",
  "scene": "hook",
  "text": "It was a lie.",
  "gap": 0.65,
  "file": "/tmp/hoplite/workspace/film/build/vo/b03.wav",
  "sr": 24000,
  "dur": 0.96
 },
 {
  "id": "b04",
  "scene": "setup",
  "text": "The CIA had dropped a spy team into Manchuria. Now, one man had to get out.",
  "gap": 0.35,
  "file": "/tmp/hoplite/workspace/film/build/vo/b04.wav",
  "sr": 24000,
  "dur": 5.12
 },
 {
  "id": "b05",
  "scene": "snatch",
  "text": "There was no runway. Just two poles in the snow, a rope between them, and a man strapped to it.",
  "gap": 0.2,
  "file": "/tmp/hoplite/workspace/film/build/vo/b05.wav",
  "sr": 24000,
  "dur": 5.077333333333334
 },
 {
  "id": "b06",
  "scene": "snatch",
  "text": "A plane swoops in low, hooks the rope, and yanks him into the sky.",
  "gap": 0.3,
  "file": "/tmp/hoplite/workspace/film/build/vo/b06.wav",
  "sr": 24000,
  "dur": 3.6693333333333333
 },
 {
  "id": "b07",
  "scene": "crew",
  "text": "In the back, two young CIA officers, John Downey and Richard Fecteau, wait to reel him in.",
  "gap": 0.45,
  "file": "/tmp/hoplite/workspace/film/build/vo/b07.wav",
  "sr": 24000,
  "dur": 5.525333333333333
 },
 {
  "id": "b08",
  "scene": "trap",
  "text": "Midnight. A bright moon. The plane slows almost to a stall.",
  "gap": 0.25,
  "file": "/tmp/hoplite/workspace/film/build/vo/b08.wav",
  "sr": 24000,
  "dur": 3.2213333333333334
 },
 {
  "id": "b09",
  "scene": "trap",
  "text": "Then, white sheets fly off the snow. Under them, two anti-aircraft guns.",
  "gap": 0.75,
  "file": "/tmp/hoplite/workspace/film/build/vo/b09.wav",
  "sr": 24000,
  "dur": 4.330666666666667
 },
 {
  "id": "b10",
  "scene": "reveal",
  "text": "The team had already been captured. The call for help was bait.",
  "gap": 0.3,
  "file": "/tmp/hoplite/workspace/film/build/vo/b10.wav",
  "sr": 24000,
  "dur": 3.3066666666666666
 },
 {
  "id": "b11",
  "scene": "reveal",
  "text": "Both pilots died. Downey and Fecteau were taken alive.",
  "gap": 0.45,
  "file": "/tmp/hoplite/workspace/film/build/vo/b11.wav",
  "sr": 24000,
  "dur": 3.2853333333333334
 },
 {
  "id": "b12",
  "scene": "lie",
  "text": "America said they were army civilians, lost at sea. For twenty years, it never said CIA.",
  "gap": 0.4,
  "file": "/tmp/hoplite/workspace/film/build/vo/b12.wav",
  "sr": 24000,
  "dur": 5.568
 },
 {
  "id": "b13",
  "scene": "prison",
  "text": "Asked to name his CIA classmates, Fecteau gave them his college football team.",
  "gap": 0.45,
  "file": "/tmp/hoplite/workspace/film/build/vo/b13.wav",
  "sr": 24000,
  "dur": 4.458666666666667
 },
 {
  "id": "b14",
  "scene": "release",
  "text": "Fecteau walked free in 1971. Downey came home only after Nixon admitted the truth.",
  "gap": 0.45,
  "file": "/tmp/hoplite/workspace/film/build/vo/b14.wav",
  "sr": 24000,
  "dur": 5.696
 },
 {
  "id": "b15",
  "scene": "ending",
  "text": "Downey became a judge. And he married a woman born in Manchuria, near the field where his plane went down.",
  "gap": 0.0,
  "file": "/tmp/hoplite/workspace/film/build/vo/b15.wav",
  "sr": 24000,
  "dur": 6.08
 }
]